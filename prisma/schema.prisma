generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// [SECURITY FIX] Model User, Account, Session, VerificationToken,
// WatchHistory, dan Favorite telah dihapus karena fitur auth
// sudah di-decommission secara permanen.
// Tabel lama di database TIDAK dihapus (safe migration).

model ApiCache {
  key       String   @id
  data      String   // JSON string
  timestamp DateTime @default(now())

  @@index([timestamp])
}
